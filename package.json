{
  "name": "operations-hub-api",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack Internal Operations Service Hub",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "dev:all": "concurrently -k -n API,WEB -c blue,green \"npm:dev\" \"npm --prefix frontend run dev\"",
    "build": "nest build",
    "build:all": "npm run build && npm --prefix frontend run build",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "user:provision": "node scripts/provision-user.js",
    "test": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "eval:ai": "jest --config jest.ai-eval.config.js --runInBand",
    "test:e2e": "npm --prefix frontend run test:e2e"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.16.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.2.5",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.4",
    "jest": "^29.7.0",
    "prisma": "^6.16.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.2"
  }
}
